{
  "name": "pragma-semantics-og-ga",
  "profile": "og-ga",
  "segment": "_TEXT",
  "function": "f",
  "text": "{{PRAGMA}}\nint f(int *p, int n, int seed)\n{\n    int i;\n    int x = seed;\n    int y = 3;\n    int z = 5;\n    for (i = 0; i < n; ++i) {\n        x += p[i] * y;\n        y += z;\n        z = (z * 3) ^ i;\n    }\n    return (x + y + z) + (seed + 1);\n}\n",
