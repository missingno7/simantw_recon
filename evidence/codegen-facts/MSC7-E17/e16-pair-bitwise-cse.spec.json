{
  "name": "e16-pair-bitwise-cse",
  "profile": "og",
  "function": "pair",
  "text": "int pair(int a, int b, int c, int d)\n{\n    return (({{LEFT}}) & c) ^ (({{RIGHT}}) | d);\n}\n",
  "mode": "one-at-a-time",
  "axes": {
    "LEFT": {
      "same_tree": "a + b"
    },
    "RIGHT": {
      "same_tree": "a + b",
      "commuted": "b + a",
      "negated_form": "a - (-b)",
      "folded_constant": "a + (b * 1)",
      "association": "(a + 1) + (b - 1)"
    }
  }
}
