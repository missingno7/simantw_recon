{
  "symbol": "_FloodNestB",
  "spec": {
    "symbol": "_FloodNestB",
    "template": "/*\n * FloodNestB updates the B-side nest cells in the shared map.  Each row\n * starts at offset three and spans the remaining 0x3d cells.  Values in the\n * flooding band 0x20..0x2d receive the flood increment; low values at or\n * below 0x13 become the full-water marker 0x50.\n */\nextern unsigned char near MapB[];\n\nvoid FloodNestB(void)\n{\n@DECLS@\n    int value;\n    unsigned char near *p;\n\n    for (row = 0; row < 0x1000; row += 0x40) {\n        for (cell = 3; cell < 0x40; ++cell) {\n            @ADDRESS@\n            value = *p;\n            if (value >= 0x20 && value <= 0x2d)\n                *p += 0x31;\n            else if (*p <= 0x13)\n                *p = 0x50;\n        }\n    }\n}\n",
    "axes": [
      {
        "name": "counter_lifetime_hints",
        "marker": "@DECLS@",
        "rationale": "Prior batch showed ordinary and both-registered row/cell declarations collapse; test independent local register hints for the outer and inner counters before leaving source-level allocation.",
        "values": [
          "    int row;\n    int cell;",
          "    register int row;\n    int cell;",
          "    int row;\n    register int cell;",
          "    register int row;\n    register int cell;"
        ]
      },
      {
        "name": "equivalent_near_map_address",
        "marker": "@ADDRESS@",
        "rationale": "All forms name the exact MAPSYM object MapB and preserve row+cell indexing; test operand ordering and indexed lvalue address lowering, which may determine which loop counter seeds SI.",
        "values": [
          "p = MapB + row + cell;",
          "p = MapB + cell + row;",
          "p = &MapB[row + cell];"
        ]
      }
    ],
