        "docs/build-topology.md"
      ],
      "matched": [
        "far_data"
      ]
    },
    {
      "id": "parameter-copied-to-local",
      "rule": "When the historical code holds a parameter's value in SI/DI throughout, an explicit local copy of the parameter (register variable candidate) can be required; the compiler does not enregister [bp+n] parameters directly.",
      "evidence": [
        "docs/grinder-lessons.md"
      ],
      "matched": [
        "si_di_home"
      ]
    },
    {
      "id": "mapsym-name-over-invented",
      "rule": "Never invent a convenient symbol when MAPSYM provides the real one: use the exact name from direct_data_bindings; an unnamed operand inside a named public array is an index into that array, not a new private object.",
      "evidence": [
