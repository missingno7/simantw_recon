      ],
      "matched": [
        "si_di_home"
      ]
    },
    {
      "id": "explicit-result-variable",
      "rule": "A historical return tail of the form MOV DX,1 / MOV AX,... (or a result set on several paths) is reproduced by an explicit result variable assigned on each path and returned once, not by multiple return statements.",
      "evidence": [
