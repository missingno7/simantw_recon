  "reconstruction_rules": [
    {
      "id": "declaration-order-ds-es",
      "rule": "Declaration order can determine DS versus ES code generation: the compiler keeps the last-loaded far selector live, so the order in which far objects are first referenced in the source (not the extern declaration order) fixes ES reuse and the CONST selector-pool order. Reorder references, not declarations, to change selector traffic.",
      "evidence": [
        "evidence/topology/build-topology.json",
        "docs/build-topology.md"
      ],
      "matched": [
        "far_data"
      ]
    },
    {
      "id": "mapsym-name-over-invented",
      "rule": "Never invent a convenient symbol when MAPSYM provides the real one: use the exact name from direct_data_bindings; an unnamed operand inside a named public array is an index into that array, not a new private object.",
      "evidence": [
        "docs/grinder-lessons.md",
        "evidence/topology/supervisor-far-names/bindings.json"
      ],
      "matched": [
        "always"
      ]
    },
    {
      "id": "offset-is-not-identity",
      "rule": "A matching numeric offset does not establish object identity: equal offsets in different segments are different objects, and a BSS word placed by constraint inside another object's data proves nothing.",
      "evidence": [
        "tools/library_match.py",
        "docs/build-topology.md"
      ],
      "matched": [
        "always"
      ]
    },
    {
      "id": "far-object-needs-selector",
      "rule": "Far-object identity requires selector/segment evidence: an NE selector relocation on the slot or immediate that loads ES, resolved to the object's segment. Prefer the packet's addressed_segment and exact_mapsym_names.",
      "evidence": [
        "docs/grinder-lessons.md"
      ],
      "matched": [
        "far_data"
      ]
    },
    {
      "id": "natural-static-private-state",
      "rule": "Reconstruct private state as natural static data with an evidence-backed size, type and initializer (a static in _DATA when the original bytes are initialised, in _BSS only when the original word lies in the BSS region), never as address-padding arrays.",
      "evidence": [
        "docs/grinder-lessons.md",
        "evidence/topology/supervisor-private-state/initialized-data-evidence.json"
      ],
      "matched": [
        "private_data"
      ]
    },
    {
      "id": "selector-pool-is-per-object",
      "rule": "The CONST selector pool is private to one object and ordered by first reference across the whole unit; a function whose pool constraints conflict in isolation needs its unit context, and functions sharing a pool word belong to the same unit.",
      "evidence": [
        "evidence/topology/build-topology.json"
      ],
      "matched": [
        "far_data"
      ]
    },
    {
      "id": "compiler-profile-is-unit-level",
      "rule": "The compiler profile belongs to the unit context (layout/compiler-profiles.json): use the packet profile as given; a code-shape mismatch that only /Og explains is profile evidence for the unit (report it), not a per-function flag to try.",
      "evidence": [
        "layout/compiler-profiles.json",
        "evidence/experiments/optimizer-profile/README.md"
      ],
      "matched": [
        "always"
      ]
    },
    {
      "id": "intrinsic-fingerprints",
      "rule": "Inline REP STOSW/MOVSW from simple loops and struct copies are ordinary /Oelw code; REPNE SCASB (strlen) or REP MOVSB over a computed length are /Oi intrinsic fingerprints and count as profile evidence for the unit rather than as hand-written loops.",
      "evidence": [
        "evidence/experiments/optimizer-profile/README.md"
      ],
      "matched": [
        "string_ops"
      ]
    },
    {
      "id": "dx8-dy8-separate-words",
      "rule": "Dx8 (segment 8 offset 0) and Dy8 (offset 8) are two MAPSYM symbols; in objects whose pool block holds two adjacent segment-8 words for them (simtwo:3EF8 C57E/C580, simant:6A38 BF70/BF72) index each with the bare direction (`Dx8[i]`, `Dy8[i]`), never `Dy8[i+8]` or `(Dx8+8)`; one word per symbol. The one-Dx8-object spelling applies only where a single word serves all displacements.",
      "evidence": [
        "src/recovered/wf_AddRandAntLion-bd2ae22846.c",
        "src/recovered/wf_DoTroph-349038dca8.c",
        "evidence/recovery/mirror-pairs/AddRandAntLion.json"
      ],
      "matched": [
        "far_data"
      ]
    },
    {
      "id": "argument-push-order",
      "rule": "Values computed only to feed a call are emitted in argument push order (right to left), not statement order: when the target loads `Dy8` before `Dx8` the call is `f(..., lx, ly)` with ly the last argument. Reorder arguments/locals before rewriting expressions.",
      "evidence": [
        "src/recovered/wf_AddRandAntLion-bd2ae22846.c"
      ],
      "matched": [
        "far_data"
      ]
    },
    {
      "id": "ymappop-own-words",
      "rule": "YMapPopB (seg 8 +0xA4) and YMapPopR (+0x164) are 12x16 byte maps indexed `(x << 4) + y`, each through its own selector word; the symbol supplies the base displacement (do not add 0xA4/0x164).",
