      ]
    },
    {
      "id": "mapsym-name-over-invented",
      "rule": "Never invent a convenient symbol when MAPSYM provides the real one: use the exact name from direct_data_bindings; an unnamed operand inside a named public array is an index into that array, not a new private object.",
      "evidence": [
