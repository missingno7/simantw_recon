        "tools/library_match.py"
      ],
      "matched": [
        "same_segment_call"
      ]
    },
    {
      "id": "declaration-order-ds-es",
      "rule": "Declaration order can determine DS versus ES code generation: the compiler keeps the last-loaded far selector live, so the order in which far objects are first referenced in the source (not the extern declaration order) fixes ES reuse and the CONST selector-pool order. Reorder references, not declarations, to change selector traffic.",
      "evidence": [
        "evidence/topology/build-topology.json",
        "docs/build-topology.md"
      ],
      "matched": [
        "far_data"
      ]
    },
    {
      "id": "parameter-copied-to-local",
      "rule": "When the historical code holds a parameter's value in SI/DI throughout, an explicit local copy of the parameter (register variable candidate) can be required; the compiler does not enregister [bp+n] parameters directly.",
      "evidence": [
        "docs/grinder-lessons.md"
      ],
      "matched": [
        "si_di_home"
      ]
    },
    {
      "id": "word-indexed-arrays",
      "rule": "Arrays are frequently word-indexed (SHL 1 / ADD reg,reg before the displacement). Preserve the observed element width: declare int arrays for two-byte strides, char arrays for byte strides, eight-byte structs for SHL 3.",
      "evidence": [
        "docs/grinder-lessons.md"
      ],
      "matched": [
