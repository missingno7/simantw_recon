    {
      "id": "declaration-order-ds-es",
      "rule": "Declaration order can determine DS versus ES code generation: the compiler keeps the last-loaded far selector live, so the order in which far objects are first referenced in the source (not the extern declaration order) fixes ES reuse and the CONST selector-pool order. Reorder references, not declarations, to change selector traffic.",
      "evidence": [
        "evidence/topology/build-topology.json",
        "docs/build-topology.md"
      ],
      "matched": [
        "far_data"
      ]
    },
    {
      "id": "mapsym-name-over-invented",
      "rule": "Never invent a convenient symbol when MAPSYM provides the real one: use the exact name from direct_data_bindings; an unnamed operand inside a named public array is an index into that array, not a new private object.",
      "evidence": [
        "docs/grinder-lessons.md",
        "evidence/topology/supervisor-far-names/bindings.json"
      ],
      "matched": [
        "always"
      ]
    },
    {
      "id": "offset-is-not-identity",
      "rule": "A matching numeric offset does not establish object identity: equal offsets in different segments are different objects, and a BSS word placed by constraint inside another object's data proves nothing.",
      "evidence": [
        "tools/library_match.py",
        "docs/build-topology.md"
      ],
      "matched": [
        "always"
      ]
    },
    {
      "id": "far-object-needs-selector",
      "rule": "Far-object identity requires selector/segment evidence: an NE selector relocation on the slot or immediate that loads ES, resolved to the object's segment. Prefer the packet's addressed_segment and exact_mapsym_names.",
      "evidence": [
        "docs/grinder-lessons.md"
      ],
      "matched": [
        "far_data"
      ]
    },
    {
      "id": "selector-pool-is-per-object",
      "rule": "The CONST selector pool is private to one object and ordered by first reference across the whole unit; a function whose pool constraints conflict in isolation needs its unit context, and functions sharing a pool word belong to the same unit.",
      "evidence": [
        "evidence/topology/build-topology.json"
      ],
      "matched": [
        "far_data"
      ]
    },
